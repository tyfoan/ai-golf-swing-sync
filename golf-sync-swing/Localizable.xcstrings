    "Drag the sliders to align with the Start, Contact, and End of the swing.": {
      "comment": "A description below the swing-timeline sliders, instructing the user to align them with the start, contact, and end of a swing.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Schieberegler, um Start, Treffer und Ende des Schwungs auszurichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los controles para alinear el inicio, el impacto y el final del swing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse les curseurs pour aligner le début, l’impact et la fin du swing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina i cursori per allineare l'inizio, l'impatto e la fine dello swing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライダーをドラッグして、スイングの開始・インパクト・終了に合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이더를 끌어 스윙의 시작·임팩트·종료에 맞추세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os controles para alinhar o início, o impacto e o fim do swing."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra reglagen för att rikta in svingens start, träff och slut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากแถบเลื่อนเพื่อปรับให้ตรงกับจุดเริ่ม จุดอิมแพค และจุดสิ้นสุดของสวิง"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动滑块以对齐挥杆的起点、击球与终点。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягни ползунки, чтобы выровнять начало, удар и конец свинга."
