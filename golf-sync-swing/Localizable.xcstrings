    "Record your swing and get an instant replay.\nSwings are detected automatically.": {
      "comment": "A description of how to use the positioning guide overlay.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm deinen Schwung auf und sieh dir eine sofortige Wiederholung an.\nSchwünge werden automatisch erkannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba tu swing y obtén una repetición instantánea.\nLos swings se detectan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ton swing et obtiens une relecture instantanée.\nLes swings sont détectés automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
