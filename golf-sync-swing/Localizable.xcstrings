            "value": "스윙을 녹화하면 즉시 리플레이됩니다.\n스윙은 자동으로 감지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave seu swing e veja o replay na hora.\nOs swings são detectados automaticamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in din sving och få en omedelbar repris.\nSvingar identifieras automatiskt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
