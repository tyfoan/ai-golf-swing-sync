        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme und ihre Schwünge werden dauerhaft gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement et ses swings seront supprimés définitivement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録画とそのスイングは完全に削除されます。"
          }
        },
