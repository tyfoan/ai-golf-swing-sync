    "Unable to save data permanently. Your recordings may not persist between sessions.": {
      "comment": "Alert shown at launch when persistent SwiftData storage fails and the app falls back to in-memory storage",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten können nicht dauerhaft gespeichert werden. Aufnahmen bleiben zwischen Sitzungen möglicherweise nicht erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden guardar los datos de forma permanente. Es posible que tus grabaciones no se mantengan entre sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer les données de façon permanente. Tes enregistrements risquent de ne pas être conservés entre les sessions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare i dati in modo permanente. Le tue registrazioni potrebbero non essere mantenute tra le sessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを永続的に保存できません。録画はセッション間で保持されない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 영구적으로 저장할 수 없습니다. 녹화가 세션 간 유지되지 않을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar dados permanentemente. Suas gravações podem não persistir entre sessões."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att spara data permanent. Dina inspelningar kanske inte sparas mellan sessioner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกข้อมูลถาวรได้ การบันทึกของคุณอาจไม่คงอยู่ระหว่างเซสชัน"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法永久保存数据。录像可能不会在会话间保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся сохранить данные надолго. Записи могут не сохраниться между сеансами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається зберегти дані постійно. Записи можуть не зберігатися між сеансами."
          }
        }
      }
    },
