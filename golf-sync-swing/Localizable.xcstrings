    "Stand 8-12 feet from the camera for optimal pose tracking.": {
      "comment": "Recording tip 3 body — short sheet version",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dich 2,5–3,5 m von der Kamera entfernt auf für optimale Pose-Erkennung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiens-toi à 2,5–3,5 m de la caméra pour un suivi optimal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラから 2.5〜3.5 m 離れて立つと、ポーズ検出に最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라에서 2.5〜3.5 m 떨어져 서면 포즈 추적이 가장 잘 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离相机 2.5–3.5 米站立，以获得最佳姿势追踪效果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitúate a 2,5–3,5 m de la cámara para un seguimiento de pose óptimo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå 2,5–3,5 m från kameran för bästa posespårning."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique a 2,5–3,5 m da câmera para um rastreamento ideal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนห่างจากกล้อง 2.5–3.5 ม. เพื่อการติดตามท่าทางที่ดีที่สุด"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettiti a 2,5–3,5 m dalla camera per un tracciamento ottimale."
          }
        }
      }
    },
    "Stand 8-12 feet from the camera for optimal pose tracking. Make sure your full body is visible throughout the entire swing motion.": {
      "comment": "Recording tip 3 body — full instructions overlay version",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dich 2,5–3,5 m von der Kamera entfernt auf. Achte darauf, dass dein ganzer Körper während der gesamten Schwungbewegung sichtbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiens-toi à 2,5–3,5 m de la caméra. Assure-toi que ton corps entier reste visible pendant tout le mouvement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラから 2.5〜3.5 m 離れて立ち、スイング動作中は全身がフレームに収まるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라에서 2.5〜3.5 m 떨어져 서고, 스윙 동작 내내 전신이 화면에 보이도록 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离相机 2.5–3.5 米站立，并确保整个挥杆动作中全身都在画面内。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitúate a 2,5–3,5 m de la cámara. Asegúrate de que todo tu cuerpo sea visible durante todo el movimiento del swing."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå 2,5–3,5 m från kameran. Se till att hela kroppen syns under hela svingrörelsen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique a 2,5–3,5 m da câmera. Garanta que seu corpo inteiro fique visível durante todo o movimento do swing."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนห่างจากกล้อง 2.5–3.5 ม. และให้เห็นเต็มตัวตลอดจังหวะการสวิง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettiti a 2,5–3,5 m dalla camera. Assicurati che tutto il corpo sia visibile per l’intero movimento di swing."
          }
        }
      }
