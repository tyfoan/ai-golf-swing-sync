        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до камери потрібен, щоб знімати твої свінги й порівнювати їх із профі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问相机后，你可以录制高尔夫挥杆并与职业选手对比。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
