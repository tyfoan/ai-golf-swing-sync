    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description: shown in the system prompt that asks for the camera",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Kamerazugriff kannst du deine Golfschwünge aufnehmen und mit Profis vergleichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access lets you record your golf swings and compare them with pros."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara te permite grabar tus swings de golf y compararlos con profesionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à l'appareil photo te permet d'enregistrer tes swings de golf et de les comparer à ceux des pros."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso alla fotocamera ti permette di registrare i tuoi swing da golf e confrontarli con i professionisti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスを許可すると、ゴルフスイングを撮影してプロと比較できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라에 접근하면 골프 스윙을 촬영하고 프로와 비교할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmera permite gravar seus swings de golfe e compará-los com os de profissionais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к камере нужен, чтобы снимать твои свинги и сравнивать их с профи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med kameraåtkomst kan du filma dina golfsvingar och jämföra dem med proffs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าถึงกล้องช่วยให้คุณบันทึกวงสวิงกอล์ฟและเปรียบเทียบกับมือโปรได้"
