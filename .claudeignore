golf-sync-swing/DemoVideos/

# Asset catalog images (binary)
*.imageset/*.png
*.imageset/*.jpg
*.appiconset/*.png

# Obsolete scripts (superseded by ml-training/extract_5class_dataset.py)
scripts/

# Completed plans (historical, not active)
plans/

# macOS metadata
.DS_Store

# Playwright MCP logs
.playwright-mcp/

# Python artifacts
__pycache__/
*.pyc
venv/

# Git internals
.git/

# SPM build
.build/

# Package resolution (lock file, not code)
Package.resolved
